  $("rOut").innerHTML='<p class="sub">Suggested stop loss <b>$'+sl+'</b> (8% of capital) and take profit <b>$'+tp+'</b> (7%). At this ladder your stop loss allows about <b>'+safe+'</b> losses in a row.</p><table><tr><th>Step</th><th>Stake</th><th>Total at risk</th></tr>'+rows+'</table><button class="bl" style="margin-top:8px" onclick="$(\'tp\').value='+tp+';$(\'sl\').value='+sl+'">Use these limits</button><p class="sub warn">These are risk limits, not a way to guarantee profit.</p>';
}
function journal(c,p){J.unshift({t:new Date().toLocaleString(),m:c.underlying||"",k:c.contract_type||"",s:c.buy_price,p:p.toFixed(2)});J=J.slice(0,200);try{localStorage.setItem("journal",JSON.stringify(J))}catch(e){}}
function renderJ(){
  const t=$("jT");t.innerHTML="<tr><th>Time</th><th>Market</th><th>Type</th><th>Stake</th><th>P/L</th></tr>";
  J.forEach(r=>{const tr=t.insertRow();[r.t,r.m,r.k,r.s,r.p].forEach((v,i)=>{const c=tr.insertCell();c.textContent=v;if(i===4)c.style.color=v>0?"#4ade80":"#f87171"})});
}
function clrJ(){J=[];try{localStorage.removeItem("journal")}catch(e){}renderJ()}
function dlJ(){const csv="time,market,type,stake,profit\n"+J.map(r=>[r.t,r.m,r.k,r.s,r.p].map(v=>'"'+v+'"').join(",")).join("\n");
  const a=document.createElement("a");a.href=URL.createObjectURL(new Blob([csv],{type:"text/csv"}));a.download="journal.csv";a.click()}
setInterval(()=>{if(live())ws.send('{"ping":1}');if(mlive())mws.send('{"ping":1}')},25000);
openMarket();
/* ---------- panels, loaders, files ---------- */
function renderDigits(){
  const c=Array(10).fill(0);digits.forEach(d=>c[d]++);
  const n=digits.length||1,pc=c.map(v=>100*v/n),mx=Math.max(...pc),mn=Math.min(...pc),cu=digits[digits.length-1];
  $("digs").innerHTML=pc.map((v,i)=>'<div class="'+(digits.length?(v===mx?"hi":v===mn?"lo":""):"")+(i===cu?" cu":"")+'">'+i+'<small>'+v.toFixed(1)+'%</small></div>').join("");
  $("eo").innerHTML=digits.slice(-20).map(d=>'<span class="'+(d%2?"o":"e")+'">'+(d%2?"O":"E")+'</span>').join("");
}
function rtab(n){["sum","tx","log"].forEach(k=>$("r-"+k).classList.toggle("hid",k!==n))}
const SV=["market","stake","count","ticks","tp","sl","sample","speed","qType","qMg","qMul","qCap","qRec","aN","aCond","aAct"];
function dl(n,t,m){const a=document.createElement("a");a.href=URL.createObjectURL(new Blob([t],{type:m}));a.download=n;a.click()}
function saveBot(){const o={};SV.forEach(k=>o[k]=$(k).value);dl("trading-hub-bot.json",JSON.stringify(o,null,1),"application/json");log("💾 Bot file saved")}
function loadBot(i){
  const f=i.files[0];if(!f)return;const r=new FileReader();
  r.onload=()=>{try{const o=JSON.parse(r.result);SV.forEach(k=>{if(o[k]!=null)$(k).value=o[k]});subTicks();log("📂 Bot file loaded")}catch(e){alert("That file is not a valid bot file.")}};
  r.readAsText(f);i.value="";
}
document.addEventListener("click",e=>{
  const b=e.target.closest("button[data-w]");if(!b||b.disabled)return;
  const k=b.dataset.w,old=b.textContent,t0=Date.now();
  const done={trade:()=>pend===0,scan:()=>!mlive()||Object.keys(scanRes).length>=Object.keys(MK).length,bot:()=>true,nav:()=>false}[k]||(()=>true);
  b.dataset.busy="1";b.disabled=true;b.textContent="⏳ "+(b.dataset.t||"Working…");
  const iv=setInterval(()=>{const el=Date.now()-t0;
    if((el>(k==="trade"?1500:800)&&done())||el>25000){clearInterval(iv);delete b.dataset.busy;b.disabled=false;b.textContent=old}},300);
});
renderDigits();
tab("dash");
</script>

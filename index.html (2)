    bot.stake=bot.loss>0?Math.min(bot.cap,Math.max(base,+(bot.loss/Math.max(.2,(bot.ratio||1.9)-1)).toFixed(2))):base;
  }else bot.stake=p>0?base:Math.min(bot.stake*bot.mul,bot.cap);

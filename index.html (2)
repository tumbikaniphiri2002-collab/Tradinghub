/* ---------- trading ---------- */
function inputs(spec){
  const stake=+$("stake").value,t=Math.round(+$("ticks").value),sym=$("market").value;
  if(!(stake>=0.35))return{err:"Stake must be at least $0.35."};
  if(!(t>=1&&t<=10))return{err:"Ticks must be 1 to 10."};
  if((spec.type==="CALL"||spec.type==="PUT")&&t<5)return{err:"Rise/Fall needs at least 5 ticks."};
  return{stake,t,sym};
}
function place(spec,n,fromBot){
  const o=inputs(spec);
  if(!(n>=1&&n<=10))o.err="Trades per burst must be 1 to 10.";
  if(fromBot&&bot&&(bot.mg||bot.rec)&&bot.stake)o.stake=bot.stake;
  if(o.err){if(fromBot)stopBot(o.err);else alert(o.err);return false}
  if(!live())return false;
  log("🚀 "+n+"× "+spec.type+(spec.barrier?" "+spec.barrier:"")+" at $"+o.stake);
  for(let i=0;i<n;i++)setTimeout(()=>{
    if(!live())return;pend++;
    const p={amount:o.stake,basis:"stake",contract_type:spec.type,currency:cur,duration:o.t,duration_unit:"t"};p[useAlt?"underlying_symbol":"symbol"]=o.sym;
    if(spec.barrier)p.barrier=spec.barrier;
    ws.send(JSON.stringify({buy:1,price:o.stake,parameters:p}));
  },i*(+$("speed").value||300));
  return true;
}
function guard(msg){
  if(!live()){alert("Trading connection is not open yet. Wait a few seconds, or check the Results log.");return false}
  return isDemo()||confirm("⚠️ REAL MONEY account.\n"+msg+"\nContinue?");
}
function manual(spec){if(guard("Place "+(+$("count").value)+" trades of "+spec.type+"?"))place(spec,+$("count").value)}
function aiRun(){
  if(!aiPick||digits.length<30){alert("Wait for 30 ticks.");return}
  if(guard("AI picked "+aiPick.l+". Place "+(+$("count").value)+" trades of $"+$("stake").value+"?"))place(aiPick,+$("count").value);
}
function onContract(d){
  const c=d.proposal_open_contract;
  if(!c||!c.is_sold||done.has(c.contract_id))return;
  done.add(c.contract_id);pend=Math.max(0,pend-1);
  if(d.subscription)ws.send(JSON.stringify({forget:d.subscription.id}));
  const p=Number(c.profit);sess.n++;p>0?sess.w++:sess.l++;sess.p+=p;sess.s+=+c.buy_price||0;sess.y+=+c.sell_price||0;sess.tx.unshift({k:(c.contract_type||"")+(c.barrier?" "+c.barrier:""),s:+c.buy_price||0,y:+c.sell_price||0,p});sess.tx=sess.tx.slice(0,30);journal(c,p);mgUpdate(p,c);
  log((p>0?"✅ Won +":"❌ Lost ")+p.toFixed(2));renderStats();
  if(bot){const r=sess.p-bot.p0,tp=+$("tp").value,sl=+$("sl").value;

<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>Trading Hub</title>
<meta name="deriv-site-verification" content="4f24dff4484e1d149ef2143a519d5bb0e08128082be6396c55853764a714503b">
<style>
:root{--bg:#0b0f14;--c:#131a22;--b:#263140;--t:#e6edf3;--m:#8b98a8;--g:#1f9d55;--r:#d64545;--a:#f2b134;--bl:#3b82f6}
*{box-sizing:border-box;margin:0;padding:0;font-family:system-ui,-apple-system,Segoe UI,Roboto,sans-serif}
body{background:var(--bg);color:var(--t);padding:12px 12px 100px;max-width:520px;margin:auto}
header{display:flex;justify-content:space-between;align-items:center;margin-bottom:12px}
h1{font-size:1.15rem;letter-spacing:.3px}
h2{font-size:.9rem;color:var(--m);margin-bottom:8px;font-weight:600}
.badge{padding:4px 10px;border-radius:12px;font-size:.78rem;font-weight:700;background:var(--r)}
.badge.on{background:var(--g)}
.card{background:var(--c);border:1px solid var(--b);border-radius:8px;padding:12px;margin-bottom:12px}
label{display:block;font-size:.72rem;color:var(--m);margin-bottom:3px}
input,select,button{width:100%;padding:10px;margin-bottom:8px;border-radius:6px;border:1px solid var(--b);background:var(--bg);color:#fff;font-size:.92rem}
button{border:0;background:var(--g);font-weight:700;cursor:pointer}
button:disabled{background:#1b232d;color:#4b5563}
.row{display:grid;gap:8px}.r2{grid-template-columns:1fr 1fr}.r3{grid-template-columns:repeat(3,1fr)}
.tabs button{background:var(--c);border:1px solid var(--b);color:var(--m);margin:0 0 12px}
.tabs button.act{background:var(--bl);color:#fff;border-color:var(--bl)}
.hid{display:none!important}
.sub{font-size:.8rem;color:var(--m);margin-bottom:8px;line-height:1.4}
.price{display:flex;justify-content:space-between;align-items:center;background:var(--bg);padding:10px;border-radius:6px}
.price strong{font-size:1.25rem;color:#4ade80}
.ai{border:1px solid var(--bl);border-radius:8px;padding:10px;margin-bottom:10px}
.ai b{color:#7db2ff}
.up{background:var(--g)}.dn{background:var(--r)}.bl{background:var(--bl)}.am{background:#a16207}.go{background:linear-gradient(90deg,#2563eb,#7c3aed);padding:13px}
.bot{border:1px solid var(--b);border-radius:8px;padding:10px;margin-bottom:8px}
.bot b{display:block;margin-bottom:3px}
.tag{display:inline-block;font-size:.68rem;background:var(--a);color:#000;padding:1px 6px;border-radius:8px;margin-left:6px;font-weight:700}
.bot button{margin:6px 0 0}
.stats{display:grid;grid-template-columns:repeat(4,1fr);gap:6px;text-align:center;margin-bottom:8px}
.stats div{background:var(--bg);border-radius:6px;padding:6px}
.stats small{display:block;color:var(--m);font-size:.68rem}
.log{background:var(--bg);border:1px solid var(--b);border-radius:6px;padding:8px;font:.76rem monospace;max-height:150px;overflow:auto;color:var(--m)}
.log div{padding:2px 0;border-bottom:1px solid var(--c)}
.warn{border-left:3px solid var(--a);padding-left:8px}
#fab{position:fixed;right:14px;bottom:18px;width:58px;height:58px;border-radius:50%;background:linear-gradient(135deg,#2563eb,#7c3aed);font-size:1rem;z-index:6;margin:0;padding:0;box-shadow:0 4px 14px #0008}
#panel{position:fixed;left:10px;right:10px;bottom:86px;max-width:500px;margin:auto;max-height:62vh;overflow:auto;background:var(--c);border:1px solid var(--bl);border-radius:10px;padding:12px;z-index:6}
.scan{display:flex;justify-content:space-between;align-items:center;gap:8px;border-bottom:1px solid var(--b);padding:7px 0;font-size:.85rem}
.scan button{width:auto;padding:6px 12px;margin:0}
nav{display:flex;gap:6px;overflow-x:auto;margin-bottom:12px;padding-bottom:4px}
nav button{width:auto;white-space:nowrap;margin:0;background:var(--c);border:1px solid var(--b);color:var(--m);padding:9px 12px}
nav button.act{background:var(--bl);color:#fff;border-color:var(--bl)}
table{width:100%;border-collapse:collapse;font-size:.76rem}th,td{padding:5px;border-bottom:1px solid var(--b);text-align:left}
.bar{display:flex;align-items:flex-end;gap:4px;height:80px;margin-bottom:18px}.bar div{flex:1;background:var(--bl);border-radius:3px 3px 0 0;position:relative}
.bar small{position:absolute;bottom:-15px;left:0;right:0;text-align:center;font-size:.65rem;color:var(--m)}
canvas{width:100%;height:auto;background:var(--bg);border-radius:6px}
.pill{padding:5px 10px;border-radius:14px;background:var(--bg);font-size:.82rem;border:1px solid var(--b)}
body:not(.in) :is(nav,.pg,#setCard,#resCard,#fab,#panel,#acct,#botStatus,.authonly){display:none!important}
body.in #login{display:none}
button[data-busy]{opacity:.75}
.dig{display:grid;grid-template-columns:repeat(5,1fr);gap:6px;margin:8px 0}
.dig div{border:2px solid var(--b);border-radius:50%;aspect-ratio:1;display:flex;flex-direction:column;align-items:center;justify-content:center;font-weight:700}
.dig small{font-size:.6rem;color:var(--m);font-weight:400}
.dig .hi{border-color:#4ade80}.dig .lo{border-color:#f87171}.dig .cu{background:var(--bl)}
.eo{display:flex;flex-wrap:wrap;gap:3px;margin-bottom:10px}
.eo span{width:20px;height:20px;border-radius:4px;font-size:.7rem;display:flex;align-items:center;justify-content:center;font-weight:700}
.eo .e{background:#0d9488}.eo .o{background:#dc2626}
</style>
</head>
<body>
<header><h1>⚡ Trading Hub</h1><div style="display:flex;gap:6px;align-items:center"><a href="https://app.deriv.com/cashier/deposit" target="_blank" rel="noopener" class="badge authonly" style="color:#fff;text-decoration:none">Deposit</a><span class="pill authonly"><span id="hbal">0.00</span> <span id="hcur"></span></span><span id="st" class="badge">Logged out</span></div></header>
<nav id="nav"></nav>
<div id="botStatus" class="card ai hid"><b id="botName"></b><p class="sub" id="botWait" style="margin:4px 0 0"></p><button class="dn" onclick="stopBot('Stopped by you')">Stop bot</button></div>

<section class="card" id="login">
  <h2>Sign in</h2>
  <p class="sub">Log in or create a free Deriv account. Deriv will ask you to allow access to trading.</p>
  <p class="sub warn">Trading carries a high risk of losing money. Signals only describe recent ticks and are not predictions or financial advice. Practise on a demo account first.</p>
  <p id="loginMsg" class="sub warn hid"></p>
  <button class="go" data-w="nav" data-t="Opening Deriv…" onclick="loginDeriv(false)">Log in</button>
  <button class="bl" data-w="nav" data-t="Opening Deriv…" onclick="loginDeriv(true)">Create account</button>
  <details><summary class="sub">Use an API token instead</summary>
    <input type="password" id="tok" placeholder="Deriv API token (demo recommended)">
    <button class="bl" onclick="useToken()">Connect with token</button>
  </details>
</section>

<section class="card hid" id="acct">
  <div class="row r2">
    <div><label>Account (Demo or Real)</label><select id="accSel" onchange="switchAcc();openTrading()"></select></div>
    <div><label>Balance</label><strong><span id="bal">0.00</span> <span id="cur">USD</span></strong></div>
  </div>
  <button class="bl hid" id="resetBtn" onclick="resetDemo()">Reset demo balance</button>
  <button class="dn" onclick="logout()">Log out</button>
</section>

<section class="card" id="setCard">
  <h2>Market and trade settings</h2>
  <label>Volatility market</label>
  <select id="market" onchange="subTicks()"></select>
  <div class="price"><span>Live price</span><strong id="price">connecting…</strong></div>
  <div class="row r3" style="margin-top:8px">
    <div><label>Stake ($)</label><input type="number" id="stake" value="1" min="0.35" step="0.5"></div>
    <div><label>Trades per burst</label><input type="number" id="count" value="3" min="1" max="10"></div>
    <div><label>Ticks</label><input type="number" id="ticks" value="5" min="1" max="10"></div>
  </div>
  <div class="row r2">
    <div><label>Take profit ($, bots)</label><input type="number" id="tp" value="10" min="0"></div>
    <div><label>Stop loss ($, bots)</label><input type="number" id="sl" value="20" min="0"></div>
  </div>
  <div class="row r2"><button class="bl" onclick="saveBot()">Save bot file</button><button class="bl" onclick="$('botFile').click()">Load bot file</button></div>
  <input type="file" id="botFile" accept=".json" class="hid" onchange="loadBot(this)">
</section>



<section id="p-bulk" class="card pg">
  <h2>Digit analysis</h2>
  <div class="row r2"><div><label>Sample size (ticks)</label><select id="sample" onchange="subTicks()"><option>30</option><option selected>100</option><option>500</option><option>1000</option></select></div>
  <div><label>Execution speed</label><select id="speed"><option value="150">Fast</option><option value="400" selected>Normal</option></select></div></div>
  <div class="dig" id="digs"></div><div class="eo" id="eo"></div>
  <h2>AI analyser</h2>
  <div class="ai">
    <div>Best pattern now: <b id="aiSig">collecting ticks…</b></div>
    <p class="sub" id="aiWhy" style="margin:4px 0 0">Needs 30 ticks.</p>
  </div>
  <button class="go" id="aiRun" data-w="trade" data-t="Placing trades…" onclick="aiRun()" disabled>🤖 AI analyse and run bulk trades</button>
  <p class="sub">Set your stake and number of trades above. The AI picks the strongest recent pattern on this market and places all trades.</p>
  <div class="row r3">
    <button class="up" data-w="trade" data-t="Placing…" onclick="manual({type:'CALL'})">Rise</button>
    <button class="dn" data-w="trade" data-t="Placing…" onclick="manual({type:'PUT'})">Fall</button>
    <button class="bl" data-w="trade" data-t="Placing…" onclick="manual({type:'DIGITEVEN'})">Even</button>
    <button class="am" data-w="trade" data-t="Placing…" onclick="manual({type:'DIGITODD'})">Odd</button>
    <button class="up" data-w="trade" data-t="Placing…" onclick="manual({type:'DIGITOVER',barrier:'3'})">Over 3</button>
    <button class="dn" data-w="trade" data-t="Placing…" onclick="manual({type:'DIGITUNDER',barrier:'6'})">Under 6</button>
  </div>
</section>

<section id="p-free" class="card pg hid">
  <h2>Free bots</h2>
  <p class="sub">Each bot watches the selected market, waits for its pattern, places ONE trade, waits for the result, then watches again. Sniper bots wait for rarer patterns. Bots stop at your take profit or stop loss.</p>
  <div id="botList"></div>
</section>

<section id="p-dash" class="card pg"><h2>Dashboard</h2>
<div class="stats"><div><small>Balance</small><b id="dBal">0.00</b></div><div><small>Win rate</small><b id="dWr">0%</b></div><div><small>Profit</small><b id="dP">0.00</b></div><div><small>Trades</small><b id="dN">0</b></div></div>
<p class="sub warn" id="connNote">Live prices are running. Placing trades needs the trading connection; check the Results log if it does not open.</p>
<p class="sub">Log in, choose a market in Trade settings, then open a tool from the menu above.</p>
<div class="row r2"><button class="bl" onclick="tab('bulk')">Bulk Trader</button><button class="bl" onclick="tab('free')">Free Bots</button><button class="bl" onclick="tab('quick')">Quick Bot</button><button class="bl" onclick="tab('signal')">Signal AI</button></div></section>

<section id="p-premium" class="card pg hid"><h2>Premium bots</h2>
<p class="sub">Reversal bots. Every signal fires a burst of trades (your "Trades per burst" setting), so they trade more often and risk more than the free bots.</p>
<div id="premList"></div></section>

<section id="p-quick" class="card pg hid"><h2>Quick Bot</h2>
<p class="sub">Trades one contract at a time, back to back, and waits for each result before the next. Uses your stake, take profit and stop loss.</p>
<label>Contract</label><select id="qType"></select>
<div class="row r2"><div><label>Martingale</label><select id="qMg"><option value="0">Off</option><option value="1">On</option></select></div><div><label>Multiplier</label><input type="number" id="qMul" value="2" min="1.1" step="0.1"></div></div>
<label>Recovery mode</label><select id="qRec"><option value="0">Off</option><option value="1">On: after a loss, raise the stake to try to win it back</option></select>
<label>Max stake ($) that caps martingale and recovery</label><input type="number" id="qCap" value="10" min="1">
<p class="sub warn">Martingale raises your stake after every loss and can empty a balance fast. It is off by default and the cap limits it.</p>
<button class="up" data-w="bot" data-t="Starting…" onclick="startQuick()">Start Quick Bot</button></section>

<section id="p-auto" class="card pg hid"><h2>Auto Trader rule</h2>
<div class="row r2"><div><label>If the last N</label><input type="number" id="aN" value="3" min="1" max="10"></div>
<div><label>are all</label><select id="aCond"><option value="even">Even digits</option><option value="odd">Odd digits</option><option value="low">Digits 0-3</option><option value="high">Digits 6-9</option><option value="up">Rising ticks</option><option value="dn">Falling ticks</option></select></div></div>
<label>Then trade</label><select id="aAct"></select>
<button class="up" data-w="bot" data-t="Starting…" onclick="startAuto()">Start Auto Trading</button>
<p class="sub">Example: if the last 5 digits are all even, trade Even. Uses your stake, trades per burst, take profit and stop loss.</p></section>

<section id="p-signal" class="card pg hid"><h2>Signal AI</h2>
<div class="row r2"><div><label>Minimum edge %</label><input type="number" id="sigMin" value="8"></div><div><label>&nbsp;</label><button class="bl" id="sigBtn" onclick="sigToggle()">Start scanning</button></div></div>
<div class="sub" id="sigState">Scanner is off. Signals show where a recent pattern is strong. They are not predictions.</div>
<div id="sigFeed"></div>
<h2 style="margin-top:12px">Digit frequency (last 100 ticks)</h2><div class="bar" id="dBars"></div></section>

<section id="p-risk" class="card pg hid"><h2>Risk calculator</h2>
<div class="row r3"><div><label>Capital ($)</label><input type="number" id="rCap" value="20"></div><div><label>Base stake ($)</label><input type="number" id="rBase" value="0.4" step="0.05"></div><div><label>Multiplier</label><input type="number" id="rMul" value="2" step="0.1"></div></div>
<button class="bl" onclick="calcRisk()">Calculate</button><div id="rOut"></div></section>

<section id="p-chart" class="card pg hid"><h2>Live chart</h2><canvas id="cv" width="600" height="300"></canvas><p class="sub" id="cvInfo">Log in to see live ticks.</p></section>

<section id="p-journal" class="card pg hid"><h2>Journal</h2>
<div class="row r2"><button class="bl" onclick="dlJ()">Download CSV</button><button class="dn" onclick="clrJ()">Clear</button></div>
<div style="overflow-x:auto"><table id="jT"></table></div></section>

<section class="card" id="resCard">
  <div class="row r3" style="margin-bottom:8px"><button class="bl" onclick="rtab('sum')">Summary</button><button class="bl" onclick="rtab('tx')">Transactions</button><button class="bl" onclick="rtab('log')">Log</button></div>
  <div id="r-sum"><div class="stats"><div><small>Total stake</small><b id="sS">0.00</b></div><div><small>Payout</small><b id="sY">0.00</b></div><div><small>Trades</small><b id="sN">0</b></div><div><small>Profit</small><b id="sP">0.00</b></div></div>
  <div class="stats" style="grid-template-columns:repeat(3,1fr)"><div><small>Won</small><b id="sW">0</b></div><div><small>Lost</small><b id="sL">0</b></div><div><small>Win rate</small><b id="sR">0%</b></div></div></div>
  <div id="r-tx" class="hid" style="overflow-x:auto"><table id="txT"></table></div>
  <div id="r-log" class="hid"><div class="log" id="log">Ready.</div></div>
  <p class="sub" id="lastLog" style="margin:6px 0"></p>
  <button class="bl" onclick="resetStats()">Reset results</button>
</section>

<button id="fab" onclick="$('panel').classList.toggle('hid')">AI</button>
<div id="panel" class="hid">
  <h2>Volatility scanner</h2>
  <p class="sub">Scans the last 100 ticks of every Volatility market and shows where a pattern is strongest. Tap Use to switch to that market.</p>
  <button class="bl" data-w="scan" data-t="Scanning…" onclick="scan()">Scan volatility markets</button>
  <div id="scanOut" class="sub">No scan yet.</div>
</div>

<script>
// PUT YOUR REGISTERED DERIV APP ID HERE
const APP_ID = "351tNZiIAHYfpVlNrstTM"; // your Deriv client ID
const AUTH = "https://auth.deriv.com/oauth2/auth";
const TOKEN = "https://auth.deriv.com/oauth2/token";
const REDIRECT = location.origin + location.pathname; // must match the redirect URL registered with Deriv exactly
const WS_URL = "wss://ws.derivws.com/websockets/v3?app_id=1089"; // old API, used only by the token box
const MK = {R_10:"Volatility 10",R_25:"Volatility 25",R_50:"Volatility 50",R_75:"Volatility 75",R_100:"Volatility 100",
  "1HZ10V":"Volatility 10 (1s)","1HZ25V":"Volatility 25 (1s)","1HZ50V":"Volatility 50 (1s)","1HZ75V":"Volatility 75 (1s)","1HZ100V":"Volatility 100 (1s)"};
const BOTS = [
  {id:1,name:"Parity Reverser",t:"par",n:3,d:"After 3 digits of the same parity in a row, trades the opposite (even/odd)."},
  {id:2,name:"Parity Sniper",t:"par",n:6,sn:1,d:"Waits for 6 same-parity digits in a row, then trades the opposite."},
  {id:3,name:"Over 3 Scalper",t:"low",n:2,d:"After 2 low digits (0-3) in a row, trades Over 3."},
  {id:4,name:"Over 3 Sniper",t:"low",n:4,sn:1,d:"Waits for 4 low digits (0-3) in a row, then trades Over 3."},
  {id:5,name:"Under 6 Sniper",t:"high",n:4,sn:1,d:"Waits for 4 high digits (6-9) in a row, then trades Under 6."},
  {id:6,name:"Momentum Follower",t:"mom",n:4,d:"After 4 ticks moving the same way, trades in that direction. Needs 5+ ticks."},
  {id:7,name:"Rise/Fall Sniper",t:"rev",n:6,sn:1,d:"Waits for 6 ticks in one direction, then trades the reversal. Needs 5+ ticks."},
  {id:8,name:"Even-Odd AI",t:"par",n:2,prem:1,burst:1,d:"All even digits trigger Odd. All odd digits trigger Even."},
  {id:9,name:"Over 4-Under 5 AI",t:"o4u5",prem:1,burst:1,d:"A digit below 4 triggers Over 4. A digit above 5 triggers Under 5."},
  {id:10,name:"Rise-Fall AI",t:"rev",n:3,prem:1,burst:1,d:"A rising run triggers Fall. A falling run triggers Rise. Needs 5+ ticks."}
];
const $ = id => document.getElementById(id);
let ws, subId = null, digits = [], prices = [], cur = "USD", lid = "", accts = [];
let rc=0,useAlt=false,tried=false,pend = 0, bot = null, sess = newSess(), done = new Set(), scanRes = {};

Object.keys(MK).forEach(k => $("market").add(new Option(MK[k], k)));
function renderList(id,arr){$(id).innerHTML=arr.map(b=>`<div class="bot"><b>${b.name}${b.sn?'<span class="tag">SNIPER</span>':''}${b.prem?'<span class="tag" style="background:#c084fc">PREMIUM</span>':''}</b><p class="sub" style="margin:0">${b.d}</p><p class="sub" style="margin:2px 0 0">${b.burst?"Fires a burst of trades per signal":"One trade per signal, waits for the result"}</p><button class="up" data-w="bot" data-t="Starting…" onclick="startBot(${b.id})">Start bot</button></div>`).join("")}
renderList("botList",BOTS.filter(b=>!b.prem));renderList("premList",BOTS.filter(b=>b.prem));

const SAMPLE=()=>+$("sample").value||100;
function newSess(){return{n:0,w:0,l:0,p:0,s:0,y:0,tx:[]}}
const live = () => ws && ws.readyState === 1;
const isDemo = () => lid.startsWith("VRTC");
function log(m){const d=document.createElement("div");d.textContent="["+new Date().toLocaleTimeString()+"] "+m;$("log").prepend(d);$("lastLog").textContent=m;const lm=$("loginMsg");lm.textContent=m;lm.classList.remove("hid")}
const TABS=[["dash","Dashboard"],["bulk","Bulk Trader"],["free","Free Bots"],["premium","Premium Bots"],["quick","Quick Bot"],["auto","Auto Trader"],["signal","Signal AI"],["risk","Risk Calc"],["chart","Charts"],["journal","Journal"]];
const TRADE=["bulk","free","premium","quick","auto","signal"];
const ACTS=[["CALL","Rise"],["PUT","Fall"],["DIGITEVEN","Even"],["DIGITODD","Odd"],["DIGITOVER:3","Over 3"],["DIGITUNDER:6","Under 6"]];
["qType","aAct"].forEach(id=>ACTS.forEach(a=>$(id).add(new Option(a[1],a[0]))));
$("nav").innerHTML=TABS.map(t=>'<button id="n-'+t[0]+'" onclick="tab(\''+t[0]+'\')">'+t[1]+'</button>').join("");
function tab(n){
  document.querySelectorAll(".pg").forEach(e=>e.classList.add("hid"));
  $("p-"+n).classList.remove("hid");
  TABS.forEach(t=>$("n-"+t[0]).className=t[0]===n?"act":"");
  $("setCard").classList.toggle("hid",!TRADE.includes(n)&&n!=="chart");
  $("resCard").classList.toggle("hid",!TRADE.includes(n)&&n!=="dash");
  if(n==="chart")drawChart();if(n==="dash")renderStats();if(n==="journal")renderJ();
  if(n==="signal")renderBars();if(n==="bulk")renderDigits();
}

/* ---------- login ---------- */
async function loginDeriv(signup){
  const cs="ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789-._~";
  const ver=Array.from(crypto.getRandomValues(new Uint8Array(64))).map(v=>cs[v%66]).join("");
  const h=await crypto.subtle.digest("SHA-256",new TextEncoder().encode(ver));
  const ch=btoa(String.fromCharCode(...new Uint8Array(h))).replace(/\+/g,"-").replace(/\//g,"_").replace(/=+$/,"");
  const st=Array.from(crypto.getRandomValues(new Uint8Array(16))).map(b=>b.toString(16).padStart(2,"0")).join("");
  localStorage.setItem("pkce_v",ver);localStorage.setItem("oauth_s",st);
  const P={response_type:"code",client_id:APP_ID,redirect_uri:REDIRECT,scope:"trade",state:st,code_challenge:ch,code_challenge_method:"S256"};
  if(signup)P.prompt="registration";
  location.href=AUTH+"?"+new URLSearchParams(P);
}
function useToken(){const t=$("tok").value.trim();if(!t){alert("Paste your token first.");return}connect(t)}
async function checkToken(tok){
  try{
    const a=await fetch("https://api.derivws.com/trading/v1/options/accounts",{headers:{Authorization:"Bearer "+tok}});
    const txt=await a.text();
    if(!a.ok){log("❌ Deriv rejected the login ("+a.status+"): "+txt.slice(0,300));return false}
    let j={};try{j=JSON.parse(txt)}catch(e){}
    const l=j.data||j.accounts||j,arr=Array.isArray(l)?l:[];

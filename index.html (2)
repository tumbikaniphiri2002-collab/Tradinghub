/* ---------- bots ---------- */
function trig(b){
  if(b.t==="o4u5"){const d=digits[digits.length-1];if(d<4)return{type:"DIGITOVER",barrier:"4"};if(d>5)return{type:"DIGITUNDER",barrier:"5"};return null}
  if(b.t==="always")return b.spec;
  if(b.t==="rule"){const D=digits.slice(-b.n),P=prices.slice(-(b.n+1));if(D.length<b.n)return null;
    const f={even:x=>x%2===0,odd:x=>x%2===1,low:x=>x<=3,high:x=>x>=6};let ok=false;
    if(f[b.cond])ok=D.every(f[b.cond]);
    else if(P.length>b.n)ok=P.every((x,i)=>!i||(b.cond==="up"?x>P[i-1]:x<P[i-1]));
    return ok?b.spec:null}
  const D=digits.slice(-b.n),P=prices.slice(-(b.n+1));
  if(D.length<b.n)return null;
  if(b.t==="par"&&D.every(x=>x%2===D[0]%2))return{type:D[0]%2?"DIGITEVEN":"DIGITODD"};
  if(b.t==="low"&&D.every(x=>x<=3))return{type:"DIGITOVER",barrier:"3"};
  if(b.t==="high"&&D.every(x=>x>=6))return{type:"DIGITUNDER",barrier:"6"};
  if((b.t==="mom"||b.t==="rev")&&P.length>b.n){
    const up=P.every((x,i)=>!i||x>P[i-1]),dn=P.every((x,i)=>!i||x<P[i-1]);
    if(up)return{type:b.t==="mom"?"CALL":"PUT"};
    if(dn)return{type:b.t==="mom"?"PUT":"CALL"};
  }
  return null;
}
function startBot(id){
  const b=BOTS.find(x=>x.id===id);
  if(bot){alert("A bot is already running. Stop it first.");return}
  if(!live()){alert("Trading connection is not open yet. Wait a few seconds, or check the Results log.");return}
  if(!(+$("sl").value>0)){alert("Set a stop loss above 0 before starting a bot.");return}
  if(!guard('Start "'+b.name+'" on '+MK[$("market").value]+'? It will trade automatically until take profit or stop loss.'))return;
  bot={b,name:b.name,busy:false,p0:sess.p,n:b.burst?0:1};showBot();log("🤖 Started "+b.name);
}

/* ---------- connection ---------- */
function connect(tok,url){
  if(ws&&ws.readyState<=1){ws.onclose=null;ws.close()}
  pend=0;bot=null;showBot();
  ws=new WebSocket(url||WS_URL);
  ws.onopen=()=>{if(url){rc=0;switchAcc();log("✅ Trading connection open");ws.send(JSON.stringify({balance:1,subscribe:1}))}else{log("Connecting…");ws.send(JSON.stringify({authorize:tok}))}};
  ws.onerror=()=>log("❌ Connection error. Check internet and App ID.");
  ws.onclose=()=>{if(url){$("st").textContent="Reconnecting…";$("st").className="badge";if(localStorage.getItem("deriv_token")&&++rc<=6)setTimeout(openTrading,2500)}else{$("st").textContent="Logged out";$("st").className="badge"}$("aiRun").disabled=true;bot=null;showBot();log("⚠️ Disconnected.")};
  ws.onmessage=e=>{let d;try{d=JSON.parse(e.data)}catch(x){return}
    if(d.error){
      log("❌ "+d.error.message+(d.error.code?" ["+d.error.code+"]":"")+(d.error.details?" "+JSON.stringify(d.error.details):""));
      if(d.echo_req&&d.echo_req.buy){
        log("Sent: "+JSON.stringify(d.echo_req.parameters||{}));
        pend=Math.max(0,pend-1);settle();
        if(/valid/i.test(d.error.message)&&!tried){tried=true;useAlt=!useAlt;log("↻ Next trade will use different field names.")}
        if(bot)stopBot("Deriv rejected a trade request");
      }
      return}
    const m=d.msg_type;
    if(m==="authorize"){const a=d.authorize;cur=a.currency;lid=a.loginid;
      $("st").textContent=isDemo()?"Demo":"REAL";$("st").className="badge on";
      document.body.classList.add("in");$("login").classList.add("hid");$("acct").classList.remove("hid");
      $("bal").textContent=$("hbal").textContent=a.balance;$("cur").textContent=$("hcur").textContent=cur;
      log("✅ Signed in: "+lid);ws.send(JSON.stringify({balance:1,subscribe:1}));subTicks()}
    else if(m==="balance")$("bal").textContent=$("hbal").textContent=d.balance.balance;
    else if(m==="tick")onTick(d.tick);
    else if(m==="history")onHistory(d);
    else if(m==="buy"){log("🟢 Bought #"+d.buy.contract_id+" ($"+d.buy.buy_price+")");
      ws.send(JSON.stringify({proposal_open_contract:1,contract_id:d.buy.contract_id,subscribe:1}))}
    else if(m==="proposal_open_contract")onContract(d);
  };
}

/* ---------- ticks and analysis ---------- */
function subTicks(){
  if(!mlive())return;
  if(subId){msend({forget:subId});subId=null}
  digits=[];prices=[];$("aiRun").disabled=true;$("aiSig").textContent="collecting ticks…";
  const s=$("market").value;
  msend({ticks_history:s,count:SAMPLE(),end:"latest",style:"ticks",req_id:99});
  msend({ticks:s,subscribe:1});
}
const dig=(p,pip)=>parseInt(Number(p).toFixed(pip).slice(-1),10);
function push(p,pip){prices.push(Number(p));digits.push(dig(p,pip));while(prices.length>SAMPLE()){prices.shift();digits.shift()}}
function onTick(t){
  if(t.symbol!==$("market").value)return;
  subId=t.id;$("price").textContent=t.quote;push(t.quote,t.pip_size||2);
  updateAI();refreshViews();
  if(bot&&!bot.busy&&pend===0){const s=trig(bot.b);
    if(s){bot.busy=true;if(!place(s,bot.n||+$("count").value,true))bot.busy=false}}
}
function onHistory(d){
  const sym=d.echo_req.ticks_history,pip=d.pip_size||2,P=d.history.prices.map(Number),D=P.map(p=>dig(p,pip));
  if(d.echo_req.req_id===99){if(sym===$("market").value){prices=P;digits=D;updateAI()}return}
  scanRes[sym]=best(P,D);renderScan();
  if(sigT&&Object.keys(scanRes).length>=Object.keys(MK).length)addSignals();
}
function best(P,D){
  const n=D.length,pc=f=>100*D.filter(f).length/n;let r=0,mv=0;
  for(let i=1;i<P.length;i++){if(P[i]>P[i-1]){r++;mv++}else if(P[i]<P[i-1])mv++}
  const rise=100*r/(mv||1);
  return [
    {type:"DIGITEVEN",l:"EVEN",s:pc(x=>x%2===0)-50,why:"Even digits are above the normal 50%."},
    {type:"DIGITODD",l:"ODD",s:pc(x=>x%2===1)-50,why:"Odd digits are above the normal 50%."},
    {type:"DIGITOVER",barrier:"3",l:"OVER 3",s:pc(x=>x>3)-60,why:"Digits above 3 are above the normal 60%."},
    {type:"DIGITUNDER",barrier:"6",l:"UNDER 6",s:pc(x=>x<6)-60,why:"Digits below 6 are above the normal 60%."},
    {type:"CALL",l:"RISE",s:rise-50,why:"More rising ticks than falling ticks."},
    {type:"PUT",l:"FALL",s:(100-rise)-50,why:"More falling ticks than rising ticks."}
  ].sort((a,b)=>b.s-a.s)[0];
}
let aiPick=null;
function updateAI(){
  if(digits.length<30){$("aiWhy").textContent="Collecting ticks ("+digits.length+"/30)…";return}
  aiPick=best(prices,digits);
  $("aiSig").textContent=aiPick.l+"  (+"+aiPick.s.toFixed(1)+"% vs normal)";
  $("aiWhy").textContent=aiPick.why+" Based on the last "+digits.length+" ticks. This describes the past, not the next tick.";
  if(!$("aiRun").dataset.busy)$("aiRun").disabled=!live();
}

